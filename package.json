{
  "name": "pispark",
  "version": "0.7.0",
  "private": true,
  "description": "An open-source, self-hosted web workspace for Pi agents.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.23.4 || ^24.0.0 || >=26.0.0",
    "npm": ">=10"
  },
  "workspaces": [
    "apps/server",
    "apps/web",
    "apps/launcher"
  ],
  "scripts": {
    "dev": "concurrently --kill-others --names server,web \"npm run dev -w @pispark/server\" \"npm run dev -w @pispark/web\"",
    "check": "prettier --check \"{apps,plugins,scripts}/**/*.{ts,js,mjs,svelte,css}\" && npm run check --workspaces",
    "test": "npm run test --workspaces",
    "build": "npm run build --workspaces",
    "start": "npm run start -w @pispark/server",
    "smoke": "node scripts/smoke.mjs",
    "format": "prettier --write \"{apps,plugins,scripts}/**/*.{ts,js,mjs,svelte,css}\""
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.2.0",
    "typescript": "~7.0.2"
  }
}
