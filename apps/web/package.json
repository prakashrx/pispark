{
  "name": "@pispark/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "build": "vite build",
    "test:browser": "playwright test",
    "format": "prettier --plugin=prettier-plugin-svelte --write src"
  },
  "dependencies": {
    "svelte": "^5.57.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tailwindcss/forms": "^0.5.10",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^22.20.5",
    "autoprefixer": "^10.6.2",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.32",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^3.4.17",
    "vite": "^6.4.5",
    "vitest": "~5.0.5"
  }
}
