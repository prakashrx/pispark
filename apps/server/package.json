{
  "name": "@pispark/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch-path=src --no-warnings src/index.ts --dev",
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-tui": "1.5.0",
    "esbuild": "^0.28.2",
    "svelte": "^5.57.3",
    "typebox": "1.3.27"
  }
}
